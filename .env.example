# Leave MONGODB_URI empty to run on the built-in local JSON data store (no DB setup needed).
# Add a real connection string when you're ready to move to MongoDB Atlas or a local mongod instance.
# For a local MongoDB server (mongod running on your machine), use:
#   MONGODB_URI=mongodb://localhost:27017/tabsha
MONGODB_URI=

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin dashboard login (protects /admin/*).
# Default dev login if these are left unset: admin@tabsha.com / Tabsha@Admin123
ADMIN_EMAIL=admin@tabsha.com
# Simplest option (used by default in .env.local): plain text, fine for local dev.
ADMIN_PASSWORD=Tabsha@Admin123
# For production, use a bcrypt hash instead (takes priority over ADMIN_PASSWORD if set):
#   node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
ADMIN_PASSWORD_HASH=

# Optional, for Stripe (future payment integration)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_NAME="Tabsha Clothing Studio"
